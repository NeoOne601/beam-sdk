        // 21*7=147, 8*3=24, 9*1=9, 8*7=56, 9*3=27, 0*1=0, 2*7=14, 12*3=36, 3*1=3
        // sum = 147+24+9+56+27+0+14+36+3 = 316 → 316%10 = 6
        assert_eq!(mrz_check_digit("L898902C3"), 6);
    }

