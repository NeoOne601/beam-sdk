    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
}
.pqc-signed { background: rgba(3, 218, 198, 0.1); color: var(--teal); }
.pqc-unsigned { background: rgba(207, 102, 121, 0.1); color: var(--error); }
.field-list { margin-bottom: 1.5rem; }
.field-item {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
}
.field-key {
    font-size: 0.75rem; color: var(--text-secondary);
    text-transform: uppercase; letter-spacing: 0.05em;
}
.field-value-row { display: flex; justify-content: space-between; align-items: baseline; }
.field-value { font-size: 1rem; font-weight: 500; }
.field-conf { font-size: 0.75rem; color: var(--teal); }

/* Settings */
.settings-container {
    max-width: 480px; width: 100%;
    padding: 2rem;
}
.settings-container h2 { font-size: 1.5rem; margin-bottom: 1.5rem; color: var(--primary); }
.setting-label {
    display: block;
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
}
.setting-input {
    display: block; width: 100%;
    padding: 0.625rem;
    margin-top: 0.375rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: var(--font);
    font-size: 0.95rem;
}
.setting-input:focus { outline: none; border-color: var(--primary); }
.setting-label input[type="checkbox"] {
    margin-right: 0.5rem;
    accent-color: var(--primary);
}
.about-section {
    margin: 1.5rem 0;
    padding: 1rem;
    background: var(--surface);
    border-radius: var(--radius);
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.8;
}

/* Responsive */
@media (max-width: 480px) {
    .hero h1 { font-size: 2rem; }
    .result-container, .settings-container { padding: 1.25rem; }
}
