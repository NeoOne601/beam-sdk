    BLUR_PASS["blur_score recorded"]
    BLUR_FAIL(["REJECT — BlurCheck\nblur_score = measured\nmean_luma = 0.0\np95_luma = 0.0\nmotion_score = 0.0\nedge_density = 0.0"])

