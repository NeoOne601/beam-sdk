<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="24sp"
            android:textColor="#BB86FC"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Backend URL"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etBackendUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:backgroundTint="#BB86FC"
            android:hint="http://10.0.2.2:8080"
            android:inputType="textUri"
            android:layout_marginBottom="24dp" />

        <Switch
            android:id="@+id/switchPqcSigning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PQC Signing (ML-DSA Level 3)"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <Switch
            android:id="@+id/switchRawMrz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Include Raw MRZ"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:layout_marginBottom="48dp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save"
            android:textSize="16sp"
            android:backgroundTint="#BB86FC"
            android:textColor="#000000" />

    </LinearLayout>
</ScrollView>
